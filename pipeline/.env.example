# Provider selection. Indian providers first; foreign ones are fallbacks.
# SAR: every listed catalogue is searched and results merged.
# METOCEAN: listed providers are merged cell by cell, first one wins (e.g. openmeteo,cmems).

SAR_PROVIDERS=eos04,sentinel1
METOCEAN_PROVIDER=openmeteo,cmems
# synthetic = tagged synthetic tracks; gfw = real GFW identities and AIS events (needs GFW_API_TOKEN)
AIS_PROVIDER=gfw
SANCTIONS_PROVIDER=unsc

# Bhoonidhi (NRSC / ISRO): EOS-04, NISAR. Use the Bhoonidhi user ID (not the email).
BHOONIDHI_USER_ID=
BHOONIDHI_PASSWORD=

# Copernicus Data Space: Sentinel-1 downloads. Catalogue search works without an account.
CDSE_USERNAME=
CDSE_PASSWORD=

# Global Fishing Watch: vessel identity and AIS gap / loitering / port-visit events.
GFW_API_TOKEN=

# Copernicus Marine: GLORYS12 reanalysis currents (fills pre-2022 gaps). Needs: uv sync --extra cmems
CMEMS_USERNAME=
CMEMS_PASSWORD=

# Not used by the pipeline yet (adapters pending): MOSDAC Oceansat-3 winds, CDS ERA5 direct.
# MOSDAC_USERNAME=
# MOSDAC_PASSWORD=
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=

# HTTP cache for provider responses (relative to the pipeline directory).
CACHE_DIR=.cache
