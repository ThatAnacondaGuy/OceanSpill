# Copy to deploy/.env and fill in. Never commit the filled copy.
# Generate each secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_DB=oceanspill
POSTGRES_USER=oceanspill
POSTGRES_PASSWORD=
# Signs session tokens. Changing it signs everyone out.
JWT_SECRET=
# Signs exported evidence documents. Changing it stops older documents verifying, so keep it safe.
SIGNING_SECRET=

# Port the site is served on.
WEB_PORT=8080
# How long a sign-in lasts, in minutes.
ACCESS_TOKEN_MINUTES=480
# Only needed when the site is served from a different origin than the API.
CORS_ORIGINS=
# How often the worker looks for due jobs, in seconds.
WORKER_INTERVAL_S=900
BACKUP_KEEP_DAYS=14

# Email for alerts that should reach someone away from the screen. Leave blank to log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAILS=

# Data provider credentials, the same names the pipeline uses (pipeline/.env).
BHOONIDHI_USERNAME=
BHOONIDHI_PASSWORD=
CDSE_USERNAME=
CDSE_PASSWORD=
GFW_API_TOKEN=
