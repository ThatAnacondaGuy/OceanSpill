# API and worker image. Both run from the same image with different commands.
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

# curl is used by the health check; the rest are build inputs for the scientific wheels.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.27 /uv /usr/local/bin/uv

WORKDIR /app

# Dependencies first, so a code change does not reinstall the world.
COPY pipeline/pyproject.toml pipeline/uv.lock /app/pipeline/
COPY pipeline/src/oceanspill/__init__.py /app/pipeline/src/oceanspill/__init__.py
RUN cd /app/pipeline && uv sync --frozen --no-dev --extra api --extra sar

COPY pipeline /app/pipeline
COPY shared /app/shared
COPY data /app/data
RUN cd /app/pipeline && uv sync --frozen --no-dev --extra api --extra sar

# Case artifacts are mounted at run time; this is where the API looks for them.
ENV DATA_DIR=/app/public/data \
    STORAGE_DIR=/app/storage

RUN useradd --system --create-home --uid 10001 oceanspill \
    && mkdir -p /app/storage /app/pipeline/.cache /app/pipeline/.secrets \
    && chown -R oceanspill:oceanspill /app
USER oceanspill

WORKDIR /app/pipeline
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

CMD ["oceanspill-api", "serve", "--host", "0.0.0.0", "--port", "8000"]
